{
  "languages": {
    "TypeScript": {
      "language_servers": [
        "...",
        "typescript-ls",
        "!vtsls",
        "!typescript-language-server",
        "!eslint",
        "!oxlint",
        "!tailwindcss-language-server",
        "!unocss-language-server"
      ]
    },
    "TSX": {
      "language_servers": [
        "...",
        "typescript-ls",
        "!vtsls",
        "!typescript-language-server",
        "!eslint",
        "!oxlint",
        "!tailwindcss-language-server",
        "!unocss-language-server"
      ]
    }
  },
  "format_on_save": "on",
  "formatter": [{ "language_server": { "name": "oxfmt" } }, { "code_action": "source.fixAll.oxc" }]
}
