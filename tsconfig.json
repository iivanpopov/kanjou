{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "jsx": "react-jsx",
    "paths": {
      "@kanjou/core": ["./packages/core/src/index.ts"],
      "@kanjou/react": ["./packages/react/src/index.ts"],
      "@kanjou/plugin": ["./packages/plugin/src/index.ts"],
      "@kanjou/plugin/*": ["./packages/plugin/src/*.ts"],
      "@kanjou/cli": ["./packages/cli/src/index.ts"],
      "@kanjou/generator": ["./packages/generator/src/index.ts"],
      "virtual:kanjou/*": ["./packages/plugin/client.d.ts"]
    }
  },
  "exclude": ["**/dist/**", "**/node_modules/**", "playground/**", "examples/**"]
}
